# Copy this file to .env and change the values before deployment.

APP_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@rcs.local
ADMIN_PASSWORD=ChangeMe!ChangeMe!
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BOT_CREDENTIALS_KEY=
# Generate a separate key using the command above.
CAMPAIGN_RECIPIENTS_KEY=
# GoDaddy cPanel production defaults to one trusted proxy; override only if your host requires it.
# TRUST_PROXY=1
# For Docker, docker-compose.yml sets DATA_DIR=/app/data on a persistent volume.
# For a direct deployment, use an absolute path on persistent disk.
# DATA_DIR=./data
NODE_ENV=development
HOST=127.0.0.1
PORT=3000